# Copia este ficheiro para .env e ajusta os valores.

# Chave que a app Android tem de enviar no header X-API-Key.
# Deixa vazio para desativar autenticacao (NAO recomendado se usares ngrok).
API_KEY=troca-esta-chave-por-uma-aleatoria

# Onde ficam guardados os ficheiros, miniaturas e a base de dados.
DATA_DIR=./data

# Interface e porta do servidor
HOST=0.0.0.0
PORT=8000

# Tamanho maximo por ficheiro enviado (MB)
MAX_UPLOAD_MB=40
# Lado maior da miniatura em pixeis
THUMB_SIZE=512

# --- PDF ---
# Extrair o texto do PDF para o tornar pesquisavel (1 = sim)
PDF_EXTRACT_TEXT=1
# Numero maximo de caracteres de texto guardados por PDF
PDF_TEXT_CHARS=20000
# Procurar rostos tambem dentro das paginas do PDF (1 = sim)
PDF_DETECT_FACES=1
# Quantas paginas do PDF sao analisadas a procura de rostos
PDF_FACE_PAGES=3

# --- Reconhecimento facial ---
# Modelo insightface: buffalo_l (melhor) ou buffalo_s (mais rapido/leve)
FACE_MODEL=buffalo_l
# Resolucao do detetor. Menor = mais rapido, menos rostos pequenos detetados.
FACE_DET_SIZE=640
# Confianca minima para aceitar um rosto detetado (0-1)
FACE_DET_THRESHOLD=0.5
# Similaridade cosseno minima para considerar que dois rostos sao a mesma pessoa (0-1)
FACE_MATCH_THRESHOLD=0.42
# Agrupar rostos automaticamente em "pessoas" (1 = sim, 0 = nao)
FACE_AUTO_CLUSTER=1
# Desativa completamente o motor facial (1 = desativado). Util para testar sem modelos.
FACE_DISABLED=0
